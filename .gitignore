# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/

# Data & Results
data/*.csv
# The RGMT daily workflow commits its target snapshot; keep that one tracked.
!data/rgmt_targets.csv
data/*.parquet
data/*.db
# Local live-executor state and kill switch; never commit account state.
data/rgmt_live_state.json
data/rgmt_live_state.json.tmp
data/RGMT_LIVE_HALT
data/.rgmt_paper.lock
research/results/
*.png
*.jpg

# Secrets - NEVER COMMIT
.env
secrets.json
*.key
*.pem

# NOTE: bot_state*.json / trades*.json / readiness_*.json / paper_readiness.json /
# walk_forward_results_*.json under data/ are NOT ignored. research/bots/bot_runner.py
# writes them locally and CI (bot.yml, refresh_gates.yml) commits them back to master —
# they ARE the persistence layer for now. Do not re-add them here until bot_runner.py
# is actually migrated to write through backend/models.py to a durable external DB
# (a GitHub Actions runner's local filesystem, including any local SQLite file, is
# destroyed at the end of every job — gitignoring these without that migration means
# every run starts from a blank slate and readiness_gate.py's fail-closed check can
# never pass).

# Logs
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Quant Research Data
quant_research/data/
quant_research/results/*.parquet

# Trendlab bulk-data cache (regenerable from data.binance.vision)
data/binance/

# Streamlit (legacy)
.streamlit/


frontend/node_modules/
start.bat
